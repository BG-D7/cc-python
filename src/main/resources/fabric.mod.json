  "authors": [
    "diff"
  ],
  "contact": {
    "homepage": "https://github.com/BG-D7/cc-python",
    "sources": "https://github.com/BG-D7/cc-python",
    "issues": "https://github.com/BG-D7/cc-python/issues"
  },
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "work.diffdev.ccpython.fabric.CCPythonFabricMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~${minecraft_version}",
    "computercraft": ">=1.120.0"
  }
}
